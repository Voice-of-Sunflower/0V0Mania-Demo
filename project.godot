config_version=5

[application]

config/name="0v0Mania Framework"
config/description="仅包含游玩界面相关的脚本和资源。"
config/version="0.0.4.0"
run/main_scene="uid://cje3r6hmqmtyi"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/show_image=false
boot_splash/minimum_display_time=1000

[autoload]

GlobalSettings="*res://Scripts/Globals/global_settings.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=3

[editor]

